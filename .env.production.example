# DocuMind — những dòng PHẢI khác đi khi triển khai thật.
#
# Cách dùng: bắt đầu từ .env.example như bình thường, rồi ghi đè các dòng dưới
# đây. API từ chối khởi động ở APP_ENV=production nếu SECRET_KEY, mật khẩu
# Postgres hay MinIO còn là giá trị mẫu.
#
# Sinh bí mật:  python -c "import secrets;print(secrets.token_urlsafe(48))"

APP_ENV=production
LOG_LEVEL=INFO

# Tên miền trỏ về máy chủ này. Caddy tự xin chứng chỉ Let's Encrypt cho nó.
# Thử nội bộ không có tên miền: DOMAIN=localhost (Caddy tự ký chứng chỉ).
DOMAIN=documind.example.com

SECRET_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Máy đích 16 GB VRAM: cuda + bật mốc hiệu năng. Máy không GPU: để cpu/false.
DEVICE=cuda
PERF_ASSERTIONS_ENABLED=true

# Privacy Mode với Ollama trong compose (profile local-llm):
DEFAULT_MODE=privacy
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LLM_CONTEXT_TOKENS=8192

# Mô hình cục bộ có ghim revision — số liệu trong báo cáo mới tái lập được.
EMBEDDING_PROVIDER=bge-m3
RERANK_PROVIDER=bge
EMBEDDING_REVISION=
RERANK_REVISION=

# Trần bộ nhớ theo container (compose.prod.yml). Chỉnh theo máy.
API_MEMORY_LIMIT=6g
WORKER_MEMORY_LIMIT=8g
OLLAMA_MEMORY_LIMIT=12g
