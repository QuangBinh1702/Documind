# Harness core maintenance binary
scripts/bin/harness
scripts/bin/harness.exe

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ── Node / Next.js ────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache

# ── Bí mật & cấu hình cục bộ ──────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Dữ liệu chạy ──────────────────────────────────────────
data/
minio-data/
postgres-data/
*.db
*.sqlite3

# ── Cache mô hình (KHÔNG commit — ~10 GB) ─────────────────
models/
.cache/
*.gguf
*.safetensors
*.onnx

# ── Kết quả spike & đánh giá ──────────────────────────────
spikes/out/
# Số đo của một máy cụ thể tại một thời điểm cụ thể. Số liệu cuối cùng đi vào
# báo cáo, không vào repo. Riêng `dataset/questions.json` thì ĐƯỢC commit —
# US-044 AC-5 yêu cầu bộ test nằm trong repo để chạy lại được.
eval/results/*.json
eval/results/*.csv
eval/results/*.svg
!eval/results/.gitkeep

# ── Danh sách tải: sinh lại được từ nguon.csv ─────────────
eval/dataset/da_tai.csv

# ── Bằng chứng: giữ file .md, bỏ ảnh/video nặng ───────────
docs/evidence/**/*.mp4
docs/evidence/**/*.mov

# ── Tài liệu nguồn: không commit tệp gốc, giữ cấu trúc thư mục ────
# Xuất xứ từng tệp ghi ở eval/dataset/NGUON.md — đó mới là thứ vào báo cáo,
# và nó đủ để người khác tải lại đúng bộ dữ liệu.
eval/dataset/documents/**/*
!eval/dataset/documents/**/
!eval/dataset/documents/**/.gitkeep

# ── Hệ điều hành / IDE ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ── Tài liệu nguồn ────────────────────────────────────────
# PDF là tệp nhị phân lớn và thường là tài liệu của người khác. Chúng không
# vào lịch sử git; tệp mẫu cho spike và bộ đánh giá nằm ngoài repo, được mô tả
# lại bằng `eval/dataset/NGUON.md` để người khác tải về đúng bộ.
# Dùng `*.pdf` chứ không phải `*pdf`: thiếu dấu chấm thì mẫu này khớp cả một
# thư mục tên `pdf` hay một tệp tên `mypdf`.
*.pdf

# Log tạm của trình duyệt tự động, sinh lại được
.playwright-mcp/
