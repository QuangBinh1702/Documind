# Harness core maintenance binary
scripts/bin/harness
scripts/bin/harness.exe

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ── Node / Next.js ────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache

# ── Bí mật & cấu hình cục bộ ──────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Dữ liệu chạy ──────────────────────────────────────────
data/
minio-data/
postgres-data/
*.db
*.sqlite3

# ── Cache mô hình (KHÔNG commit — ~10 GB) ─────────────────
models/
.cache/
*.gguf
*.safetensors
*.onnx

# ── Kết quả spike & đánh giá ──────────────────────────────
spikes/out/
eval/results/*.json
eval/results/*.csv
!eval/results/.gitkeep

# ── Danh sách tải: sinh lại được từ nguon.csv ─────────────
eval/dataset/da_tai.csv

# ── Bằng chứng: giữ file .md, bỏ ảnh/video nặng ───────────
docs/evidence/**/*.mp4
docs/evidence/**/*.mov

# ── Tài liệu nguồn: không commit tệp gốc, giữ cấu trúc thư mục ────
# Xuất xứ từng tệp ghi ở eval/dataset/NGUON.md — đó mới là thứ vào báo cáo,
# và nó đủ để người khác tải lại đúng bộ dữ liệu.
eval/dataset/documents/**/*
!eval/dataset/documents/**/
!eval/dataset/documents/**/.gitkeep

# ── Hệ điều hành / IDE ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
