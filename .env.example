# DocuMind — mẫu cấu hình. Sao chép thành .env rồi sửa.
#
#   cp .env.example .env
#
# .env KHÔNG được commit (đã có trong .gitignore).
# Mọi tham số của hệ thống nằm ở đây — không hardcode ở nơi khác (SPEC.md DoD D7).

# ══════════════════════════════════════════════════════════
# Ứng dụng
# ══════════════════════════════════════════════════════════
APP_ENV=dev
LOG_LEVEL=INFO

# BẮT BUỘC đổi khi triển khai. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-gia-tri-nay-truoc-khi-trien-khai

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ══════════════════════════════════════════════════════════
# Thiết bị tính toán  (SPEC-v1.md §10.0)
# Laptop phát triển: cpu   ·   Server đích 16 GB: cuda
# ══════════════════════════════════════════════════════════
DEVICE=cpu
EMBEDDING_DEVICE=
RERANK_DEVICE=
OCR_DEVICE=
# Bỏ trống ba dòng trên = kế thừa DEVICE. Chỉ điền khi muốn tách riêng.

# Bật các assertion hiệu năng. CHỈ bật trên máy đích — trên laptop chúng
# sẽ đỏ mà không mang ý nghĩa (SPEC.md US-057 AC-8).
PERF_ASSERTIONS_ENABLED=false

# ══════════════════════════════════════════════════════════
# Hạ tầng
# ══════════════════════════════════════════════════════════
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documind
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false

API_PORT=8000
FRONTEND_PORT=3000

# Chỉ dùng khi chạy backend NGOÀI docker (trỏ về localhost thay vì tên service)
# DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000

# ══════════════════════════════════════════════════════════
# Giới hạn nạp tài liệu  (SPEC.md US-006)
# ══════════════════════════════════════════════════════════
MAX_FILE_MB=50
MAX_IMAGE_MB=10
MAX_SOURCES_PER_NOTEBOOK=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md,png,jpg,jpeg,webp

# ══════════════════════════════════════════════════════════
# Chunking  (SPEC.md US-008)
# ══════════════════════════════════════════════════════════
CHUNK_TOKENS=768
CHUNK_OVERLAP_RATIO=0.15
CHUNK_RESPECT_HEADINGS=true

# ══════════════════════════════════════════════════════════
# Phát hiện scan & cổng chất lượng  (SPEC.md US-023, US-056)
# Cấu hình engine OCR nằm ở cuối tệp.
# ══════════════════════════════════════════════════════════
SCAN_CHARS_PER_PAGE_THRESHOLD=100
SCAN_PAGE_RATIO_THRESHOLD=0.5
TEXT_QUALITY_MIN=0.60

# ══════════════════════════════════════════════════════════
# Mô hình
# Ghim revision (commit hash HuggingFace) để kết quả tái lập được — US-045 AC-5
# ══════════════════════════════════════════════════════════
# `fake` dùng adapter tất định chạy được trên máy không GPU. Nó chỉ nắm trùng
# lặp từ vựng chứ không nắm ngữ nghĩa, nên dùng để phát triển và chạy test —
# KHÔNG dùng cho bất kỳ số liệu nào trong báo cáo.
#
# `tei` gọi ra máy chủ Text Embeddings Inference của khoa. Nó chạy CÙNG hai mô
# hình dưới đây trên GPU, nên đổi sang nó là đổi chỗ chạy chứ không đổi mô hình:
# vẫn 1024 chiều, không phải lập chỉ mục lại, TAU và ngưỡng cache vẫn giữ
# nguyên hiệu lực. Cấu hình ở mục "Dịch vụ TEI" bên dưới.
#
# ĐỌC KỸ TRƯỚC KHI BẬT: nhúng và xếp hạng lại chạy ở MỌI lượt hỏi và MỌI lượt
# nạp tài liệu, không phân biệt chế độ. Bật `tei` nghĩa là nội dung tài liệu và
# câu hỏi rời khỏi máy KỂ CẢ ở Privacy Mode, và nhãn "chạy hoàn toàn trên máy
# bạn" không còn đúng. Dùng cho phát triển trên laptop CPU; số liệu trong báo
# cáo nên chạy bằng mô hình cục bộ có ghim revision (US-045 AC-5).
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_REVISION=

# ══════════════════════════════════════════════════════════
# Dịch vụ TEI  (chỉ dùng khi EMBEDDING_PROVIDER=tei hoặc RERANK_PROVIDER=tei)
# ══════════════════════════════════════════════════════════
# Gốc tên miền, KHÔNG kèm /v1 — adapter gọi /embed và /rerank trực tiếp.
TEI_BASE_URL=https://textembedding.dutai.io.vn
TEI_API_KEY=
TEI_TIMEOUT_SECONDS=30

# Trần của dịch vụ, vượt thì nhận 413. Adapter tự chia lô theo con số này, nên
# RERANK_CANDIDATES=50 vẫn chạy được mà không phải sửa gì.
TEI_MAX_BATCH=32

LLM_PROVIDER=real

# Ai phục vụ Fast Mode: `gemini` hoặc `ollama-cloud`.
#
# Chế độ nói về DỮ LIỆU ĐI ĐÂU, không nói về nhà cung cấp. Cả hai lựa chọn đều
# gửi câu hỏi và các đoạn tài liệu ra ngoài, nên nhãn cảnh báo quyền riêng tư
# đúng ở cả hai. Privacy Mode là thứ duy nhất không gửi gì.
FAST_BACKEND=gemini

LOCAL_LLM_MODEL=qwen3-8b-q4
# Máy chủ tương thích OpenAI chạy cục bộ: Ollama, vLLM hay llama.cpp.
#
# ĐỪNG trỏ dòng này sang một dịch vụ đám mây. Nó chạy được, nhưng cờ `is_local`
# khi đó nói dối và giao diện sẽ không cảnh báo. Dùng OLLAMA_CLOUD_* bên dưới.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Ollama Cloud — trọng số mở, chạy trên máy của Ollama. Lấy khoá ở
# ollama.com/settings/keys. Đây là một lựa chọn của Fast Mode: dữ liệu VẪN rời
# khỏi máy, chỉ khác là trọng số công khai nên kết quả tái lập được.
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=gemma4:31b
OLLAMA_CLOUD_API_KEY=
GEMINI_API_KEY=
# Ghim phiên bản cụ thể, đừng dùng bí danh '-latest': bí danh hay trả 503 vì
# đông người dùng, và nó âm thầm đổi mô hình bên dưới nên hai lần chạy đánh giá
# không so được với nhau (US-045 AC-5).
#
# Bản 'flash-lite' vì hạn mức của gói miễn phí tính theo NGÀY và rất chặt với
# các mô hình lớn — xem chú thích ở app/settings.py.
GEMINI_MODEL=gemini-3.1-flash-lite

# 0.0 vì câu trả lời phải bám tài liệu, không phải để hay hơn. Nó cũng là điều
# kiện để chạy lại bộ đánh giá ra cùng một kết quả (US-045 AC-5).
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ══════════════════════════════════════════════════════════
# Retrieval — mọi giá trị dưới đây là một trục của ablation US-046
# ══════════════════════════════════════════════════════════
RETRIEVAL_VECTOR_ENABLED=true
RETRIEVAL_BM25_ENABLED=true
RETRIEVAL_TOP_N_PER_BRANCH=50
RRF_K=60
RERANK_ENABLED=true
# Hai con số khác nhau, rất dễ nhầm thành một:
#   RERANK_CANDIDATES — cross-encoder chấm bao nhiêu đoạn  (chi phối độ trễ)
#   RERANK_TOP_K      — giữ lại bao nhiêu đoạn làm ngữ cảnh (chi phối câu trả lời)
# Trên CPU hãy hạ CANDIDATES xuống 10–20 thay vì tắt hẳn rerank.
RERANK_CANDIDATES=50
RERANK_TOP_K=8

# Ngưỡng "đủ căn cứ". Tính trên thang ĐÃ sigmoid (US-011 AC-1).
# Hiệu chỉnh bằng dữ liệu ở US-047 — đừng để nguyên giá trị mặc định trong báo cáo.
TAU=0.35

CONTEXTUAL_RETRIEVAL_ENABLED=false
VERIFIER_ENABLED=false
VERIFIER_MAX_RETRY=1
HNSW_EF_SEARCH=120

# ══════════════════════════════════════════════════════════
# Định tuyến ý định  (US-066)
# ══════════════════════════════════════════════════════════
INTENT_ROUTING_ENABLED=false
INTENT_USE_LLM_FALLBACK=true

# ══════════════════════════════════════════════════════════
# Bảo mật ngữ cảnh  (US-061 — chống prompt injection từ tài liệu)
# ══════════════════════════════════════════════════════════
CONTEXT_DELIMITER=«|CHUNK|»

# ══════════════════════════════════════════════════════════
# Hội thoại
# ══════════════════════════════════════════════════════════
CONDENSE_HISTORY_TURNS=4
LOG_CONDENSED_QUERY=false
DEFAULT_MODE=privacy

# ══════════════════════════════════════════════════════════
# Cache câu trả lời NGOÀI tài liệu  (US-034, US-035)
# Bảng external_answer_cache tách biệt hoàn toàn với source_chunks — INV-3
# ══════════════════════════════════════════════════════════
# Hiệu chỉnh bằng dữ liệu ở US-064 — xem docs/evidence/M6-hieu-chinh-cache.md.
# 0.94 là ngưỡng THẤP NHẤT mà không cặp câu hỏi khác ý nào lọt qua. Ở 0.93 vẫn
# còn 'học bổng loại giỏi' bị coi là trùng ý với 'học bổng loại xuất sắc'.
EXTERNAL_CACHE_SIMILARITY=0.94
EXTERNAL_CACHE_TTL_DAYS=30
EXTERNAL_CALLS_PER_DAY=50

# ══════════════════════════════════════════════════════════
# Nhận dạng chữ  (US-024)
# ══════════════════════════════════════════════════════════
OCR_ENABLED=true
OCR_ENGINE=rapid
# ĐỪNG để `ch`: nó đọc tiếng Việt mất sạch dấu mà vẫn báo tin cậy 0.98.
OCR_REC_LANG=latin
OCR_DPI=300
OCR_MIN_CONFIDENCE=0.60

# Font Unicode để xuất hội thoại ra PDF (US-040). Bỏ trống = tự dò trên máy.
# 14 font chuẩn của PDF KHÔNG có ký tự tiếng Việt: thiếu font thì chữ có dấu in
# ra thành ô vuông mà không báo lỗi gì.
PDF_FONT=

# ══════════════════════════════════════════════════════════
# Hàng đợi xử lý  (US-021)
# ══════════════════════════════════════════════════════════
# `celery` = đẩy sang worker riêng. Đây là cách `docker compose up` chạy.
# `inline` = chạy ngay trong tiến trình API — chỉ dùng khi phát triển backend
#            trần mà không bật worker. Khởi động lại API là mất việc dở dang.
WORKER_MODE=celery
TASK_TIME_LIMIT_SECONDS=3600

# Dịch câu hỏi sang tiếng Việt trước khi truy xuất, khi câu hỏi không phải
# tiếng Việt (US-037). Tắt thì hỏi bằng tiếng Anh gần như luôn nhận
# "không tìm thấy": cross-encoder chấm cặp khác ngôn ngữ thấp hơn hẳn.
TRANSLATE_QUERY_ENABLED=true
